@page "/search"
@using System.Net.Http.Json
@using blog_csharp.DTOs
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Search</PageTitle>

@code {
    [SupplyParameterFromQuery] public string? q { get; set; }

    private List<SearchResultItem> results = new();
    private int total, page = 1;
    private const int pageSize = 10;
    private string searchQuery = "";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(q))
        {
            searchQuery = q;
            await ExecuteSearch();
        }
    }

    private async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        Nav.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery)}");
        try
        {
            var res = await Http.GetFromJsonAsync<ApiResponse<PagedData<SearchResultItem>>>(
                $"api/search?q={Uri.EscapeDataString(searchQuery)}&page={page}&pageSize={pageSize}");
            if (res?.Data != null)
            {
                results = res.Data.List;
                total = res.Data.Total;
            }
        }
        catch { }
    }

    private async Task ChangePage(int p) { page = p; await ExecuteSearch(); }
    private async Task DoSearch() { page = 1; await ExecuteSearch(); }
    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSearch();
    }
}

<div class="mb-4">
    <div class="input-group">
        <input type="text" class="form-control" @bind="searchQuery" @bind:event="oninput"
               placeholder="Search articles..." @onkeyup="OnKeyUp" />
        <button class="btn btn-primary" @onclick="DoSearch">Search</button>
    </div>
</div>

@if (results.Count > 0)
{
    <p class="text-muted">Found @total results for "@q"</p>
    @foreach (var r in results)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">
                    <a href="/post/@r.Slug" class="text-decoration-none">@r.Title</a>
                </h5>
                <p class="card-text">@((MarkupString)r.Highlight)</p>
                <small class="text-muted">@r.PublishedAt?.ToString("yyyy-MM-dd")</small>
            </div>
        </div>
    }

    @if (total > pageSize)
    {
        <nav>
            <ul class="pagination">
                <li class="page-item @(page == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(page - 1)">Previous</button>
                </li>
                <li class="page-item @(page * pageSize >= total ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(page + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}
