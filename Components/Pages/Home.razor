@page "/"
@using System.Net.Http.Json
@using blog_csharp.DTOs
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Blog</PageTitle>

@code {
    private List<PostListItem> posts = new();
    private int total, page = 1;
    private const int pageSize = 10;
    private string? sort;
    private List<CategoryItem> categories = new();
    private List<TagItem> tags = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPosts();
        try
        {
            var catRes = await Http.GetFromJsonAsync<ApiResponse<List<CategoryItem>>>("api/categories");
            if (catRes?.Data != null) categories = catRes.Data;
        }
        catch { }
        try
        {
            var tagRes = await Http.GetFromJsonAsync<ApiResponse<List<TagItem>>>("api/tags");
            if (tagRes?.Data != null) tags = tagRes.Data;
        }
        catch { }
    }

    private async Task LoadPosts()
    {
        var url = $"api/posts?page={page}&pageSize={pageSize}";
        if (!string.IsNullOrEmpty(sort)) url += $"&sort={sort}";
        try
        {
            var res = await Http.GetFromJsonAsync<ApiResponse<PagedData<PostListItem>>>(url);
            if (res?.Data != null)
            {
                posts = res.Data.List;
                total = res.Data.Total;
            }
        }
        catch { }
    }

    private async Task ChangePage(int p) { page = p; await LoadPosts(); }
    private async Task SortBy(string s) { sort = s; page = 1; await LoadPosts(); }
}

<div class="row">
    <div class="col-md-3">
        <div class="card mb-3">
            <div class="card-header fw-bold">Categories</div>
            <div class="list-group list-group-flush">
                @foreach (var c in categories)
                {
                    <a href="category/@c.Slug" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        @c.Name
                        <span class="badge bg-primary rounded-pill">@c.PostCount</span>
                    </a>
                }
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header fw-bold">Tags</div>
            <div class="card-body">
                @foreach (var t in tags)
                {
                    <a href="tag/@t.Slug" class="badge bg-secondary text-decoration-none me-1 mb-1">@t.Name (@t.PostCount)</a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="mb-3">
            <button class="btn btn-sm @(sort == "latest" || sort == null ? "btn-primary" : "btn-outline-primary") me-1"
                    @onclick='() => SortBy("latest")'>Latest</button>
            <button class="btn btn-sm @(sort == "popular" ? "btn-primary" : "btn-outline-primary")"
                    @onclick='() => SortBy("popular")'>Popular</button>
        </div>

        @foreach (var post in posts)
        {
            <div class="card mb-3">
                <div class="card-body">
                    @if (post.Pinned)
                    {
                        <span class="badge bg-warning text-dark me-1">Pinned</span>
                    }
                    <h5 class="card-title">
                        <a href="post/@post.Slug" class="text-decoration-none">@post.Title</a>
                    </h5>
                    @if (!string.IsNullOrEmpty(post.Summary))
                    {
                        <p class="card-text text-muted">@post.Summary</p>
                    }
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            By @post.Author?.Username
                            @if (post.PublishedAt.HasValue)
                            {
                                <span> · @post.PublishedAt.Value.ToString("yyyy-MM-dd")</span>
                            }
                            @if (post.Category != null)
                            {
                                <span> · <a href="/category/@post.Category.Slug">@post.Category.Name</a></span>
                            }
                        </small>
                        <small class="text-muted">
                            👁 @post.ViewCount · 💬 @post.CommentCount
                        </small>
                    </div>
                </div>
            </div>
        }

        @if (total > pageSize)
        {
            <nav>
                <ul class="pagination">
                    <li class="page-item @(page == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(page - 1)">Previous</button>
                    </li>
                    @for (int i = 1; i <= Math.Min(Math.Ceiling((double)total / pageSize), 10); i++)
                    {
                        <li class="page-item @(i == page ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                        </li>
                    }
                    <li class="page-item @(page * pageSize >= total ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(page + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>