@page "/admin"
@using System.Net.Http.Json
@using blog_csharp.DTOs
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Admin Dashboard</PageTitle>

@code {
    private StatsOverview? stats;
    private List<TopPost> topPosts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<ApiResponse<StatsOverview>>("api/stats/overview");
            if (res?.Data != null) stats = res.Data;
        }
        catch { }
        try
        {
            var res = await Http.GetFromJsonAsync<ApiResponse<List<TopPost>>>("api/stats/posts/top");
            if (res?.Data != null) topPosts = res.Data;
        }
        catch { }
    }
}

<h2>Admin Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header fw-bold">Quick Links</div>
            <div class="card-body">
                <a href="/admin/posts" class="btn btn-outline-primary me-2 mb-2">Manage Posts</a>
                <a href="/admin/posts/new" class="btn btn-outline-success me-2 mb-2">New Post</a>
                <a href="/admin/categories" class="btn btn-outline-info me-2 mb-2">Manage Categories</a>
                <a href="/admin/comments" class="btn btn-outline-warning me-2 mb-2">Manage Comments</a>
            </div>
        </div>
    </div>
</div>

@if (stats != null)
{
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card text-center">
                <div class="card-body">
                    <h3>@stats.TotalPosts</h3>
                    <small class="text-muted">Posts</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center">
                <div class="card-body">
                    <h3>@stats.TotalComments</h3>
                    <small class="text-muted">Comments</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center">
                <div class="card-body">
                    <h3>@stats.TotalUsers</h3>
                    <small class="text-muted">Users</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center">
                <div class="card-body">
                    <h3>@stats.TodayPV</h3>
                    <small class="text-muted">Today PV</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center">
                <div class="card-body">
                    <h3>@stats.TodayUV</h3>
                    <small class="text-muted">Today UV</small>
                </div>
            </div>
        </div>
    </div>
}

@if (topPosts.Count > 0)
{
    <div class="card">
        <div class="card-header fw-bold">Top Posts</div>
        <div class="list-group list-group-flush">
            @foreach (var p in topPosts)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <a href="/post/@p.Slug">@p.Title</a>
                    <span class="badge bg-primary rounded-pill">@p.ViewCount views</span>
                </div>
            }
        </div>
    </div>
}
