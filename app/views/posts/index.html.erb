<% content_for :title, "Blog Rail" %>

<div class="blog-container">
  <header class="blog-header">
    <h1><%= link_to "Blog Rail", root_path %></h1>
  </header>

  <main>
    <% if @posts.any? %>
      <div class="post-list">
        <% @posts.each do |post| %>
          <article class="post-card">
            <h2><%= link_to post.title, post_path(post) %></h2>
            <time class="post-meta" datetime="<%= post.created_at.iso8601 %>">
              <%= post.created_at.strftime("%B %d, %Y") %>
            </time>
            <p class="post-excerpt"><%= truncate(post.content, length: 200) %></p>
            <%= link_to "Read more →", post_path(post), class: "read-more" %>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">No posts yet.</p>
    <% end %>
  </main>
</div>
